{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "regions": ["sfo1"],
  "headers": [
    {
      "source": "/samples/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, immutable" }
      ]
    }
  ]
}
